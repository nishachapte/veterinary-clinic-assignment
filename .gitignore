# ---------------------------------------------------------------------------
# Dependencies
# 229 MB, and `npm ci` reproduces them byte-for-byte from package-lock.json.
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Build output — regenerated by `npm run build`, never hand-edited.
# ---------------------------------------------------------------------------
dist/
dist-ssr/
build/
*.local

# ---------------------------------------------------------------------------
# Caches — Vite's dep pre-bundle and TypeScript's incremental info.
# These go stale rather than wrong, so they must never be shared.
# ---------------------------------------------------------------------------
.vite/
*.tsbuildinfo
.eslintcache

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Environment
# VITE_API_BASE_URL and anything else that differs per machine. Note that
# everything Vite inlines into the bundle is PUBLIC, so secrets do not belong
# in a VITE_-prefixed variable in the first place.
# `.env.example` is deliberately kept: it documents which variables exist.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# ---------------------------------------------------------------------------
# Editor and tooling directories
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.qodo/
.claude/settings.local.json
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# ---------------------------------------------------------------------------
# Kept on purpose — listed so nobody "tidies" them away later:
#   package-lock.json  every install resolves to identical versions
#   api-spec/          the OpenAPI contract the client is generated against
#   docs/              the API findings that justify the schema rules
#   src/api/schema.d.ts  generated, but committed so CI needs no codegen step
# ---------------------------------------------------------------------------
